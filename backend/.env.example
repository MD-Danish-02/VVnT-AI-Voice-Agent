APP_NAME=VVnT AI Voice Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://vvnt_user:vvnt_password@localhost:5432/vvnt_voice_agent
REDIS_URL=redis://localhost:6379/0

# JWT Security (In production/staging, JWT_SECRET_KEY must be a secure secret >= 32 chars)
JWT_SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30